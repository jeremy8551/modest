<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.org.expect</groupId>
        <artifactId>modest</artifactId>
        <version>${revision}</version>
    </parent>

    <packaging>jar</packaging>
    <artifactId>modest-tool</artifactId>
    <name>${project.artifactId}</name>
    <description>Toolkit, core utilities, encryption and output utilities</description>

    <dependencies>
        <dependency>
            <groupId>cn.org.expect</groupId>
            <artifactId>modest-hutool5.7</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>cn.org.expect</groupId>
            <artifactId>modest-hutool5.8</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>cn.org.expect</groupId>
            <artifactId>modest-java5</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 自动生成ServiceLoader文件 -->
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 编译期修改 JDK 方言 class 的接口表 -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 编译期修改 JDK 方言 class 的接口表 -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- 代码生成器使用的POI依赖 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>5</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <!-- 复制 JDK 方言模块的 class 文件 -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-java-classes</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-java/modest-java5/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-java/modest-java6/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-java/modest-java7/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-java/modest-java12/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-java/modest-java16/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-hutool/modest-hutool5.7/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/modest-hutool/modest-hutool5.8/target/classes</directory>
                                    <includes>
                                        <include>**/*.class</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Java5 方言独立编译后，通过字节码增强实现 tool 模块中的接口 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enhance-java5-dialect</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java classname="cn.org.expect.asm.JavaDialectEnhancer" fork="false" failonerror="true">
                                    <arg value="${project.build.outputDirectory}"/>
                                    <classpath>
                                        <pathelement location="${project.build.outputDirectory}"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enhance-mail-implement</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java classname="cn.org.expect.asm.MailEnhancer" fork="false" failonerror="true">
                                    <arg value="${project.build.outputDirectory}"/>
                                    <classpath>
                                        <pathelement location="${project.build.outputDirectory}"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enhance-jakarta-generator</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <java classname="cn.org.expect.asm.JakartaHttpUtilsGenerator" fork="false" failonerror="true">
                                    <arg value="${project.build.outputDirectory}"/>
                                    <classpath>
                                        <pathelement location="${project.build.outputDirectory}"/>
                                        <path refid="maven.plugin.classpath"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>delete-asm-build-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/cn/org/expect/asm"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.7</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.7</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
